/* Program to find the greatest of two numbers */
#include<stdio.h>
int main()
{
    int x, y;
    printf("Enter any two numbers:");
    scanf("%d%d", &x,&y);
    if(x>y)
    printf("%d is greater than %d", x, y);
    else if(x<y)
    printf("%d is greater than %d", y, x);
    else
    printf("Both numbers are equal");
    return 0;
}